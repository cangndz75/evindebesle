model Service {
  id              String   @id @default(uuid())
  name            String
  description     String?
  image           String?
  price           Int
  isActive        Boolean  @default(true)
  isWeeklyPopular Boolean  @default(false)
  createdAt       DateTime @default(now())

  appointmentServices AppointmentService[]
  checkItems          AppointmentCheck[]
  prices              ServicePrice[] // Hayvan türüne göre fiyat
  tags                ServiceTag[] // Kedi, Köpek vs. için uygunluk
}

model ServicePrice {
  id        String @id @default(cuid())
  serviceId String
  petId     String
  price     Int

  service Service @relation(fields: [serviceId], references: [id])
  pet     Pet     @relation(fields: [petId], references: [id])
}

model ServiceTag {
  id        String @id @default(cuid())
  serviceId String
  petId     String

  service Service @relation(fields: [serviceId], references: [id])
  pet     Pet     @relation(fields: [petId], references: [id])
}

model Appointment {
  id            String            @id @default(cuid())
  userId        String
  userAddressId String?
  draftId       String?          
  draft         DraftAppointment? @relation(fields: [draftId], references: [id])

  confirmedAt   DateTime          @default(now())
  deliveredAt   DateTime?
  assignedToId  String?
  status        AppointmentStatus @default(SCHEDULED)
  summarySent   Boolean           @default(false)

  isRecurring    Boolean @default(false)
  recurringType  String?
  recurringCount Int?
  repeatInterval String?

  timeSlot              String?
  paidAt                DateTime?
  finalPrice            Float?
  isPaid                Boolean   @default(false)
  paymentConversationId String?
  paymentId             String?

  userNote             String?
  allergy              String?
  sensitivity          String?
  specialRequest       String?
  adminNote            String?
  specialRequestStatus String?
  discountRate         Int?
  discountReason       String?

  couponId             String? 
  coupon               Coupon?    @relation(fields: [couponId], references: [id])

  user       User                 @relation(fields: [userId], references: [id])
  address    UserAddress?         @relation(fields: [userAddressId], references: [id])
  services   AppointmentService[]
  checkItems AppointmentCheck[]
  media      AppointmentMedia[]
  reviews    AppointmentReview[]
  invoice    Invoice?
  pets       AppointmentPet[]
  dates      AppointmentDate[]
  petReport  PetReport[]
}

model AppointmentDate {
  id            String      @id @default(uuid())
  appointmentId String
  date          DateTime
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([appointmentId, date])
}

model AppointmentService {
  id            String @id @default(cuid())
  appointmentId String
  serviceId     String

  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])

  media       AppointmentMedia[]
}

model AppointmentCheck {
  id            String  @id @default(cuid())
  appointmentId String
  serviceId     String
  title         String
  isChecked     Boolean @default(false)
  note          String?

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  service     Service     @relation(fields: [serviceId], references: [id])
}

model AppointmentMedia {
  id            String    @id @default(cuid())
  appointmentId String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])

  appointmentServiceId String?
  service              AppointmentService? @relation(fields: [appointmentServiceId], references: [id])

  url           String
  type          MediaType
  uploadedAt    DateTime  @default(now())
}

model AppointmentReview {
  id            String   @id @default(cuid())
  appointmentId String
  userId        String
  rating        Int
  comment       String?
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
}

model AppointmentPet {
  id            String      @id @default(cuid())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId String

  ownedPetId String?
  ownedPet   OwnedPet? @relation(fields: [ownedPetId], references: [id])

  petId String?
  pet   Pet?    @relation(fields: [petId], references: [id])
}

model PetReport {
  id            String   @id @default(cuid())
  ownedPetId    String
  appointmentId String?
  mood          String?  // JSON array olarak saklanacak
  behavior      String?  // JSON array olarak saklanacak
  mealTime      String?  // JSON array olarak saklanacak
  waterIntake   String?  // JSON array olarak saklanacak
  walkTime      String?  // JSON array olarak saklanacak
  sleepStatus   String?  // JSON array olarak saklanacak         
  toiletInfo    String?                                
  comments      String?                                
  createdAt     DateTime @default(now())

  ownedPet      OwnedPet @relation(fields: [ownedPetId], references: [id], onDelete: Cascade)
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model NotificationLog {
  id         String   @id @default(cuid())
  userId     String
  type       String   
  message    String
  sentAt     DateTime @default(now())
  retryCount Int      @default(0)
  success    Boolean  @default(true)

  user User @relation(fields: [userId], references: [id])
}

model Invoice {
  id             String   @id @default(cuid())
  appointmentId  String   @unique
  invoiceNo      String   @unique
  ettn           String
  fileUrl        String
  totalPrice     Float
  taxRate        Int       @default(20)
  taxAmount      Float
  isSent         Boolean   @default(false)
  sentAt         DateTime?
  createdAt      DateTime  @default(now())

  appointment    Appointment @relation(fields: [appointmentId], references: [id])
}

model EmailLog {
  id      String   @id @default(cuid())
  userId  String
  subject String
  content String
  sentAt  DateTime @default(now())
  type    String
  success Boolean  @default(true)

  user User @relation(fields: [userId], references: [id])
}

model AdminDiscountConfig {
  id           String       @id @default(cuid())
  triggerCount Int
  type         DiscountType
  value        Int
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  createdAt   DateTime @default(now())

  userBadges UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id])
  badge Badge @relation(fields: [badgeId], references: [id])
}

model District {
  id        String   @id @default(cuid())
  name      String
  city      String
  createdAt DateTime @default(now())

  users     User[]
  addresses UserAddress[]
}

model UserAddress {
  id          String   @id @default(uuid())
  userId      String
  districtId  String
  fullAddress String
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              User          @relation(fields: [userId], references: [id])
  district          District      @relation(fields: [districtId], references: [id])
  appointments      Appointment[]
  shippingOrders    Order[]       @relation("ShippingAddress")
  billingOrders     Order[]       @relation("BillingAddress")
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  description  String?
  discountType DiscountType
  value        Int
  maxUsage     Int?
  usageCount   Int          @default(0)
  expiresAt    DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  userCoupons      UserCoupon[]
  draftAppointments DraftAppointment[]
  appointments     Appointment[]
  orders           Order[]
}

model UserCoupon {
  id       String   @id @default(cuid())
  userId   String
  couponId String
  usedAt   DateTime?

  user   User   @relation(fields: [userId], references: [id])
  coupon Coupon @relation(fields: [couponId], references: [id])
}

model DraftAppointment {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  userId         String
  userAddressId  String

  isRecurring    Boolean
  recurringType  String?
  recurringCount Int?
  timeSlot       String?

  dates          String?  // JSON array olarak saklanacak

  ownedPetIds    String?  // JSON array olarak saklanacak
  petIds         String?  // JSON array olarak saklanacak
  serviceIds     String?  // JSON array olarak saklanacak

  finalPrice     Float?
  isTest         Boolean  @default(false)

  couponId       String?
  coupon         Coupon?  @relation(fields: [couponId], references: [id])

  userNote       String?
  allergy        String?
  sensitivity    String?
  specialRequest String?

  appointments   Appointment[]   
}

model AccessInfo {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])

  keyLocation                 String?
  keyInstruction              String?
  keyPhotoUrl                 String?
  neighborName                String?
  neighborFlatNumber          String?
  doorPassword                String?
  doorNote                    String?
  alarmExists                 Boolean  @default(false)
  alarmPassword               String?
  alarmInstruction            String?
  alarmRoom                   String?
  alarmTimeoutSeconds         Int?
  notifySecurityGuard         Boolean  @default(false)
  callBeforeEnter             Boolean  @default(false)
  keyDropLocationAfterService String?
  accessNote                  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentSession {
  id                 String                @id @default(cuid())
  userId             String
  draftId            String?

  amount             Int
  currency           String                @default("TRY")

  orderId            String?               @unique
  correlationId      String?

  status             PaymentSessionStatus  @default(INIT)

  threeDSHtml        String?               // base64 decode edilmiş HTML
  threeDSResultRaw   String?               // callback'te gelen tüm alanlar (JSON string)
  mdStatus           String?
  success            Boolean?

  paymentId          String?               // genelde orderId (PSP tarafındaki id)
  appointmentId      String?               // randevu id (tahsilat başarılıysa)

  error              String?

  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum SizeType {
  LETTER  // XS, S, M, L, XL
  NUMBER  // 30, 32, 34, 36, 38
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@index([slug])
}

model Product {
  id              String   @id @default(cuid())
  name            String
  slug            String?  @unique // URL-friendly slug (drop-cut-long-sleeve-lux)
  stockCode       String?  @unique // Stok kodu
  description     String?  // Kısa açıklama
  detailText      String?  // Detaylı metin (HTML olabilir)
  price           Float
  originalPrice   Float?  // Orijinal fiyat (indirimli ürünler için)
  image           String?  // Ana görsel
  primaryImage    String?  // Birincil görsel (hover'da gösterilecek)
  secondaryImage  String?  // İkincil görsel (hover'da gösterilecek)
  gender          Gender?  // Cinsiyet
  sizeType        SizeType? // Beden tipi (LETTER veya NUMBER)
  fabricType      String?  // Kumaş tipi (Pamuk, Polyester, vb.)
  categoryId      String?  // Kategori ID
  brand           String?  // Marka
  weight          Float?   // Ağırlık (kg)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category        Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  colors          ProductColor[]
  sizes           ProductSize[]
  tags            ProductTag[]
  combinations    ProductCombination[] @relation("ProductCombinations")
  relatedProducts ProductCombination[] @relation("RelatedProducts")
  reviews         ProductReview[]
  sizeOptions     ProductSizeOption[]
  variants        ProductVariant[]
  productImages   ProductImage[] // Ürün resimleri (genel ve renk bazlı)
  favorites       ProductFavorite[]
  viewHistory     ProductViewHistory[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@index([categoryId])
}

model ProductColor {
  id        String   @id @default(cuid())
  productId String
  name      String   // Renk adı (Kırmızı, Mavi, vb.)
  hexCode   String?  // Hex renk kodu (#FF0000)
  images    String?  // JSON array olarak saklanacak (Bu renge ait fotoğraflar) - DEPRECATED: ProductImage kullanılacak
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[] // Bir renk için birden fazla variant (her beden için)
  reviews ProductReview[] // Bu renge ait yorumlar
  productImages ProductImage[] // Bu renge ait resimler
  cartItems CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  colorId   String?  // Hangi renge ait (null ise genel ürün resmi - primaryImage, secondaryImage)
  variantId String?  // Hangi varyanta ait (opsiyonel - variant'a özel resimler için)
  url       String   // Resim URL'i
  order     Int      @default(0) // Sıralama (0, 1, 2, 3...)
  isPrimary Boolean  @default(false) // Ana resim mi? (primaryImage)
  isSecondary Boolean @default(false) // İkincil resim mi? (secondaryImage)
  alt       String?  // Alt text (SEO ve erişilebilirlik için)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([colorId])
  @@index([variantId])
  @@index([order])
  @@index([isPrimary])
  @@index([isSecondary])
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId String
  colorId   String?  // Hangi renge ait variant (opsiyonel - ana ürün için null olabilir)
  sizeId    String?  // Hangi bedene ait variant (opsiyonel)
  variantCode String  @unique // Unique variant kodu (rastgele oluşturulacak)
  price     Float?   // Variant'a özel fiyat (opsiyonel)
  stock     Int      @default(0) // Variant stoku
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  size    ProductSize?  @relation(fields: [sizeId], references: [id], onDelete: SetNull)
  productImages ProductImage[] // Bu varyanta özel resimler

  @@unique([productId, colorId, sizeId])
  @@index([productId])
  @@index([colorId])
  @@index([sizeId])
}

model ProductSize {
  id        String   @id @default(cuid())
  productId String
  name      String   // Beden adı (XS, S, M, L, XL veya 30, 32, 34, vb.)
  stock     Int      @default(0) // Stok adedi (genel stok - renk bazlı değil)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants ProductVariant[] // Bir beden için birden fazla variant (her renk için)
  cartItems CartItem[]
  orderItems OrderItem[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductTag {
  id        String   @id @default(cuid())
  productId String
  name      String   // Etiket adı (Moda, Etiket, vb.)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
}

model ProductCombination {
  id              String   @id @default(cuid())
  productId       String   // Ana ürün
  relatedProductId String // Kombine edilen ürün
  createdAt       DateTime @default(now())

  product         Product @relation("ProductCombinations", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct  Product @relation("RelatedProducts", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId])
  @@index([productId])
  @@index([relatedProductId])
}

model ProductReview {
  id        String   @id @default(cuid())
  productId String
  colorId   String?  // Renk ID (opsiyonel, renk bazlı yorumlar için)
  userId    String?  // Kullanıcı ID (opsiyonel, misafir yorumları için)
  userName  String?  // Kullanıcı adı (misafir yorumları için)
  rating    Int      // 1-5 arası puan
  comment   String?
  isApproved Boolean @default(false) // Admin onayı
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([colorId])
  @@index([isApproved])
}

model ProductSizeOption {
  id        String   @id @default(cuid())
  productId String
  name      String   // Seçenek adı (XS, S, M, L, XL veya 30, 32, 34, vb.)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
}

model ProductFavorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model WishlistShare {
  id        String   @id @default(cuid())
  userId    String   @unique
  shareId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareId])
}

model ProductViewHistory {
  id        String   @id @default(cuid())
  userId    String?  // Kullanıcı ID (opsiyonel, misafir görüntülemeleri için)
  productId String
  viewedAt  DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([viewedAt])
  @@unique([userId, productId, viewedAt])
}

model CartItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  colorId   String?  // Seçilen renk
  sizeId    String?  // Seçilen beden
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  color   ProductColor? @relation(fields: [colorId], references: [id], onDelete: SetNull)
  size    ProductSize? @relation(fields: [sizeId], references: [id], onDelete: SetNull)

  @@unique([userId, productId, colorId, sizeId])
  @@index([userId])
  @@index([productId])
}

model CompanySettings {
  id                    String   @id @default(cuid())
  freeShippingThreshold Float    @default(99.0) // Ücretsiz kargo eşiği (TL)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([id])
}

model DashboardWidget {
  id        String   @id @default(cuid())
  userId    String?  // Admin kullanıcı ID (null ise global)
  widgetKey String   // Widget anahtarı (todayRevenue, todayOrders, aov, cancellationRate)
  position  Int      // Pozisyon (0, 1, 2, 3)
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, widgetKey])
  @@index([userId])
}

enum OrderStatus {
  PENDING      // Beklemede
  PREPARING    // Hazırlanıyor
  SHIPPED      // Kargoya verildi
  DELIVERED    // Teslim edildi
  CANCELLED    // İptal edildi
}

enum PaymentStatus {
  PENDING      // Ödeme bekleniyor
  PAID         // Ödendi
  FAILED       // Ödeme başarısız
  REFUNDED     // İade edildi
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique // Sipariş numarası (örn: ORD-20250121-001)
  userId          String
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  
  // Fiyat bilgileri
  subtotal        Float         // Ara toplam (ürünler)
  shippingCost    Float         @default(0) // Kargo ücreti
  discount        Float         @default(0) // İndirim tutarı
  total           Float         // Toplam tutar
  
  // Adres bilgileri
  shippingAddressId String?      // Teslimat adresi
  billingAddressId  String?      // Fatura adresi
  
  // Ödeme bilgileri
  paymentId       String?       // Ödeme ID (iyzico/tami)
  paymentMethod   String?       // Ödeme yöntemi
  paidAt          DateTime?
  
  // Kargo bilgileri
  trackingNumber  String?       // Kargo takip numarası
  shippedAt       DateTime?
  deliveredAt     DateTime?
  
  // Kupon
  couponId       String?
  coupon         Coupon?       @relation(fields: [couponId], references: [id])
  
  // Notlar
  customerNote   String?       // Müşteri notu
  adminNote      String?       // Admin notu
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingAddress UserAddress? @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddress  UserAddress? @relation("BillingAddress", fields: [billingAddressId], references: [id])
  items          OrderItem[]
  
  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  colorId     String?
  sizeId      String?
  
  productName String   // Ürün adı (snapshot)
  colorName   String?  // Renk adı (snapshot)
  sizeName    String?  // Beden adı (snapshot)
  image       String?  // Ürün görseli (snapshot)
  
  quantity    Int      // Adet
  unitPrice   Float    // Birim fiyat (snapshot)
  totalPrice  Float    // Toplam fiyat (quantity * unitPrice)
  
  createdAt   DateTime @default(now())
  
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
  color       ProductColor? @relation(fields: [colorId], references: [id])
  size        ProductSize? @relation(fields: [sizeId], references: [id])
  
  @@index([orderId])
  @@index([productId])
}

enum CampaignStatus {
  draft
  ready
  scheduled
  sent
}

model Campaign {
  id                String          @id @default(cuid())
  name              String
  status            CampaignStatus  @default(draft)
  subject           String
  preheader         String?
  fromName          String
  fromEmail         String
  replyTo           String?
  contentJson       String          // JSON string of blocks
  renderedHtml      String?         // Generated HTML (optional, can be generated on send)
  audienceSegmentId String?
  scheduleAt        DateTime?
  sentAt            DateTime?
  sentCount         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  createdBy         User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById       String

  @@index([status])
  @@index([createdById])
  @@index([scheduleAt])
}
