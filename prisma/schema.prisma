generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String               @id @default(uuid())
  name                   String
  email                  String               @unique
  password               String
  phone                  String?
  districtId             String?
  fullAddress            String?
  image                  String?
  isAdmin                Boolean              @default(false)
  subscriptionPlan       SubscriptionPlan     @default(FREE)
  preferredContactMethod ContactMethod?
  referralCode           String?
  emailVerified          Boolean              @default(false)
  emailVerifyToken       String?
  emailVerifyExpires     DateTime?
  marketingEmailConsent  Boolean              @default(false)
  profileNoteConsent     Boolean              @default(false)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  isTestUser             Boolean              @default(false)
  accounts               Account[]
  campaigns              Campaign[]
  cartItems              CartItem[]
  emailLogs              EmailLog[]
  feedbacks              Feedback[]
  notificationLogs       NotificationLog[]
  orders                 Order[]
  passwordResetTokens    PasswordResetToken[]
  favorites              ProductFavorite[]
  productViews           ProductViewHistory[]
  sessions               Session[]
  district               District?            @relation(fields: [districtId], references: [id])
  addresses              UserAddress[]
  userBadges             UserBadge[]
  userCoupons            UserCoupon[]
  wishlistShare          WishlistShare?
  auditLogs              AuditLog[]
  stockMovements         StockMovement[]
  returnRequests         ReturnRequest[]
  posts                  BlogPost[]
  supportTickets         SupportTicket[]
  loyaltyPoints          LoyaltyPoint[]
  userAutomations        UserAutomation[]
  analyticsEvents        AnalyticsEvent[]
  analyticsSessions      AnalyticsSession[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id         String   @id @default(uuid())
  accountId  String
  providerId String
  userId     String
  password   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model NotificationLog {
  id         String   @id @default(cuid())
  userId     String
  type       String
  message    String
  sentAt     DateTime @default(now())
  retryCount Int      @default(0)
  success    Boolean  @default(true)
  user       User     @relation(fields: [userId], references: [id])
}

model EmailLog {
  id      String   @id @default(cuid())
  userId  String
  subject String
  content String
  sentAt  DateTime @default(now())
  type    String
  success Boolean  @default(true)
  user    User     @relation(fields: [userId], references: [id])
}

model AdminDiscountConfig {
  id           String       @id @default(cuid())
  triggerCount Int
  type         DiscountType
  value        Int
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
}

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String?
  icon        String?
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  badge    Badge    @relation(fields: [badgeId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

model District {
  id        String        @id @default(cuid())
  name      String
  city      String
  createdAt DateTime      @default(now())
  users     User[]
  addresses UserAddress[]
}

model UserAddress {
  id             String   @id @default(uuid())
  userId         String
  districtId     String
  fullAddress    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  isPrimary      Boolean  @default(false)
  billingOrders  Order[]  @relation("BillingAddress")
  shippingOrders Order[]  @relation("ShippingAddress")
  district       District @relation(fields: [districtId], references: [id])
  user           User     @relation(fields: [userId], references: [id])
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  description  String?
  discountType DiscountType
  value        Int
  maxUsage     Int?
  usageCount   Int          @default(0)
  expiresAt    DateTime?
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  categoryId   String?
  gender       Gender?

  category     Category?    @relation(fields: [categoryId], references: [id])
  orders       Order[]
  userCoupons  UserCoupon[]
}

model UserCoupon {
  id       String    @id @default(cuid())
  userId   String
  couponId String
  usedAt   DateTime?
  coupon   Coupon    @relation(fields: [couponId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?   // Dikey kategori görseli
  sortOrder   Int       @default(0) // Sıralama değeri
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  gender      Gender?
  group       String?   @default("Giyim") // Giyim, Aksesuar vb.
  showOnHome  Boolean   @default(false)
  showOnMen   Boolean   @default(false)
  showOnWomen Boolean   @default(false)
  products    Product[]
  coupons     Coupon[]

  @@index([slug])
  @@index([sortOrder])
}


model Product {
  id                   String               @id @default(cuid())
  name                 String
  description          String?
  price                Float
  image                String?
  isActive             Boolean              @default(true)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  detailText           String?
  gender               Gender?
  sizeType             SizeType?
  stockCode            String?              @unique
  barcode              String?              @unique // ISBN, UPC, GTIN
  fabricType           String?
  primaryImage         String?
  secondaryImage       String?
  slug                 String?              @unique
  originalPrice        Float?
  brand                String?
  categoryId           String?
  weight               Float?
  isTrackInventory     Boolean              @default(true) // Stok takibi yapılsın mı?
  allowBackorders      Boolean              @default(false) // Stok yokken satışa izin verilsin mi?
  shipmentType         String?
  trendyolLink         String?
  modelCode            String?

  cartItems            CartItem[]
  orderItems           OrderItem[]
  category             Category?            @relation(fields: [categoryId], references: [id])
  colors               ProductColor[]
  combinations         ProductCombination[] @relation("ProductCombinations")
  relatedProducts      ProductCombination[] @relation("RelatedProducts")
  favorites            ProductFavorite[]
  productImages        ProductImage[]
  reviews              ProductReview[]
  sizes                ProductSize[]
  sizeOptions          ProductSizeOption[]
  tags                 ProductTag[]
  variants             ProductVariant[]
  viewHistory          ProductViewHistory[]
  stockMovements       StockMovement[]
  productSuppliers     ProductSupplier[]
  supplyOrderItems     SupplyOrderItem[]
  stockAlerts          StockAlert[]
  priceAlerts          PriceAlert[]
  bundleItems          BundleItem[]
  stockNotifications   StockNotification[]  @relation("StockNotifications")
  washingInstructionId String?
  deliveryInfoId       String?
  sizeNoteId           String?
  sizeGuideId          String?
  modelInfoId          String?

  washingInstruction WashingInstruction? @relation(fields: [washingInstructionId], references: [id])
  deliveryInfo       DeliveryInfo?       @relation(fields: [deliveryInfoId], references: [id])
  sizeNote           SizeNote?           @relation(fields: [sizeNoteId], references: [id])
  sizeGuide          SizeGuide?          @relation(fields: [sizeGuideId], references: [id])
  modelInfo          ModelInfo?          @relation(fields: [modelInfoId], references: [id])

  showcaseItem         Showcase?
  tabbedCarouselItems  TabbedCarouselProduct[]
  collectionItems      CollectionProduct[]
  newArrivalItem       NewArrival?
  lookConfiguration    LookConfiguration? @relation("MainProductLook")
  lookItems            LookItem[]

  @@index([categoryId])
  @@index([price])
  @@index([isActive, price])
  @@index([isActive, categoryId, gender, createdAt])
  @@index([fabricType])
}

model ProductColor {
  id            String           @id @default(cuid())
  productId     String
  name          String
  hexCode       String?
  description   String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  images        String?
  cartItems     CartItem[]
  orderItems    OrderItem[]
  product       Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  productImages ProductImage[]
  reviews       ProductReview[]
  variants      ProductVariant[]

  @@index([productId])
  @@index([name])
  @@index([productId, name])
}

model ProductImage {
  id          String          @id @default(cuid())
  productId   String
  colorId     String?
  variantId   String?
  url         String
  order       Int             @default(0)
  isPrimary   Boolean         @default(false)
  isSecondary Boolean         @default(false)
  alt         String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  color       ProductColor?   @relation(fields: [colorId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([colorId])
  @@index([variantId])
  @@index([order])
  @@index([isPrimary])
  @@index([isSecondary])
}

model ProductVariant {
  id             String          @id @default(cuid())
  productId      String
  colorId        String?
  variantCode    String          @unique
  price          Float?
  stock          Int             @default(0)
  stockReserved  Int             @default(0)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  sizeId         String?
  barcode        String?
  dimension      String?
  supplierCode   String?
  marketPrice    Decimal?
  salePrice      Decimal?
  buyBoxPrice    Decimal?
  commissionRate Decimal?
  vatRate        Decimal?
  otvRate        Decimal?
  productImages  ProductImage[]
  color          ProductColor?   @relation(fields: [colorId], references: [id])
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  size           ProductSize?    @relation(fields: [sizeId], references: [id])
  stockMovements StockMovement[]
  stockAlerts    StockAlert[]

  @@index([productId])
  @@index([colorId])
  @@index([sizeId])
  @@index([barcode])
  @@index([productId, colorId, sizeId])
  @@index([productId, isActive])
  @@index([price])
  @@index([stock, stockReserved])
}

model ProductSize {
  id         String           @id @default(cuid())
  productId  String
  name       String
  stock      Int              @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  cartItems  CartItem[]
  orderItems OrderItem[]
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variants   ProductVariant[]

  @@unique([productId, name])
  @@index([productId])
  @@index([name])
}

model ProductTag {
  id        String   @id @default(cuid())
  productId String
  name      String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
}

model ProductCombination {
  id               String   @id @default(cuid())
  productId        String
  relatedProductId String
  createdAt        DateTime @default(now())
  product          Product  @relation("ProductCombinations", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product  @relation("RelatedProducts", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@unique([productId, relatedProductId])
  @@index([productId])
  @@index([relatedProductId])
}

model ProductReview {
  id         String        @id @default(cuid())
  productId  String
  userId     String?
  userName   String?
  rating     Int
  comment    String?
  isApproved Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  colorId    String?
  color      ProductColor? @relation(fields: [colorId], references: [id])
  product    Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([colorId])
  @@index([isApproved])
}

model ProductSizeOption {
  id        String   @id @default(cuid())
  productId String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
}

model ProductFavorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model WishlistShare {
  id        String   @id @default(cuid())
  userId    String   @unique
  shareId   String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shareId])
}

model ProductViewHistory {
  id        String   @id @default(cuid())
  userId    String?
  productId String
  viewedAt  DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, viewedAt])
  @@index([userId])
  @@index([productId])
  @@index([viewedAt])
}

model CartItem {
  id        String        @id @default(cuid())
  userId    String
  productId String
  colorId   String?
  sizeId    String?
  quantity  Int           @default(1)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  color     ProductColor? @relation(fields: [colorId], references: [id])
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      ProductSize?  @relation(fields: [sizeId], references: [id])
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, colorId, sizeId])
  @@index([userId])
  @@index([productId])
  @@index([userId, updatedAt])
}

model CompanySettings {
  id                    String @id @unique @default(cuid())
  freeShippingThreshold Float  @default(99.0)
  shippingPrice         Float  @default(49.90)

  companyName    String? @default("Evindebesle")
  companyAddress String?
  taxOffice      String? // Vergi dairesi
  taxNumber      String? // Vergi numarası
  phone          String?
  email          String?
  logoUrl        String?
  website        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DashboardWidget {
  id        String   @id @default(cuid())
  userId    String?
  widgetKey String
  position  Int
  isVisible Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, widgetKey])
  @@index([userId])
}

model Order {
  id                String          @id @default(cuid())
  orderNumber       String          @unique
  userId            String
  email             String?
  status            OrderStatus     @default(PENDING_PAYMENT)
  paymentStatus     PaymentStatus   @default(PENDING)
  subtotal          Float
  shippingCost      Float           @default(0)
  discount          Float           @default(0)
  total             Float
  shippingAddressId String?
  billingAddressId  String?
  paymentId         String?
  paymentMethod     String?
  paidAt            DateTime?
  trackingNumber    String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  couponId          String?
  customerNote      String?
  adminNote         String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  billingAddress    UserAddress?    @relation("BillingAddress", fields: [billingAddressId], references: [id])
  coupon            Coupon?         @relation(fields: [couponId], references: [id])
  shippingAddress   UserAddress?    @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  riskScore         Int?            @default(0)
  riskAnalysis      String?
  returnRequests    ReturnRequest[]

  idempotencyKey    String?            @unique
  reservedUntil     DateTime?
  currency          String             @default("TRY")
  payment           PaymentAttempt?
  stockReservations StockReservation[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])

  invoices Invoice[]
}

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique // F-20240001 gibi
  orderId         String
  status          InvoiceStatus @default(DRAFT)
  
  companyDetails  Json          // Şirket bilgileri
  customerDetails Json          // Müşteri bilgileri
  items           Json          // Ürün kalemleri
  
  subtotal        Float
  taxAmount       Float
  totalAmount     Float
  
  issuedAt        DateTime?
  dueDate         DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([invoiceNumber])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
}

model AuditLog {
  id            String   @id @default(cuid())
  entityId      String?
  entityType    String?
  action        String
  oldValue      Json?
  newValue      Json?
  details       Json?
  ipAddress     String?
  userAgent     String?
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id])
  createdAt     DateTime @default(now())

  @@index([entityId])
  @@index([entityType])
}

model OrderItem {
  id                 String              @id @default(cuid())
  orderId            String
  productId          String
  colorId            String?
  sizeId             String?
  productName        String
  colorName          String?
  sizeName           String?
  image              String?
  quantity           Int
  unitPrice          Float
  totalPrice         Float
  createdAt          DateTime            @default(now())
  color              ProductColor?       @relation(fields: [colorId], references: [id])
  order              Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product            Product             @relation(fields: [productId], references: [id])
  size               ProductSize?        @relation(fields: [sizeId], references: [id])
  returnRequestItems ReturnRequestItem[]

  @@index([orderId])
  @@index([productId])
}

model Campaign {
  id                String         @id @default(cuid())
  name              String
  status            CampaignStatus @default(draft)
  subject           String?
  preheader         String?
  fromName          String?
  fromEmail         String?
  replyTo           String?
  contentJson       String?
  renderedHtml      String?
  audienceSegmentId String?
  scheduleAt        DateTime?
  sentAt            DateTime?
  sentCount         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdById       String
  createdBy         User           @relation(fields: [createdById], references: [id], onDelete: Cascade)

  emailSends EmailSend[]
  emailLinks EmailLink[]

  @@index([status])
  @@index([createdById])
  @@index([scheduleAt])
}

model EmailSend {
  id          String    @id @default(cuid())
  campaignId  String
  userId      String?
  email       String
  trackingId  String    @unique @default(uuid())
  status      String    @default("pending")
  sentAt      DateTime?
  openedAt    DateTime?
  clickedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  convertedAt DateTime?
  revenue     Float?

  campaign Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  events   EmailEvent[]

  @@index([campaignId])
  @@index([userId])
  @@index([email])
  @@index([trackingId])
}



model Automation {
  id          String           @id @default(cuid())
  name        String
  description String?
  triggerType String // WELCOME, WINBACK, ABANDONED_CART, POST_PURCHASE
  isActive    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  steps       AutomationStep[]
  userFlows   UserAutomation[]
}

model AutomationStep {
  id           String   @id @default(cuid())
  automationId String
  type         String // EMAIL, DELAY, CONDITION
  order        Int
  delaySeconds Int? // If type=DELAY
  templateId   String? // If type=EMAIL
  config       Json? // Extra config (e.g., variant weights for A/B)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  automation Automation     @relation(fields: [automationId], references: [id], onDelete: Cascade)
  template   EmailTemplate? @relation(fields: [templateId], references: [id])
}

model EmailTemplate {
  id        String           @id @default(cuid())
  name      String
  subject   String
  bodyJson  String // Tiptap JSON content
  isActive  Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  steps     AutomationStep[]
}

model UserAutomation {
  id           String   @id @default(cuid())
  userId       String
  automationId String
  currentStep  Int      @default(0) // Step order number
  status       String // ACTIVE, COMPLETED, CANCELLED
  startedAt    DateTime @default(now())
  lastStepTime DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([automationId])
  @@index([status])
}

model EmailLink {
  id          String   @id @default(cuid())
  campaignId  String
  originalUrl String
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model EmailEvent {
  id          String   @id @default(cuid())
  emailSendId String
  type        String
  meta        String?
  userAgent   String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  emailSend EmailSend @relation(fields: [emailSendId], references: [id], onDelete: Cascade)

  @@index([emailSendId])
}

enum SubscriptionPlan {
  FREE
  PREMIUM
  PRO
}

enum ContactMethod {
  EMAIL
  PHONE
  WHATSAPP
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum PaymentSessionStatus {
  INIT
  AUTH_SENT
  AUTH_OK
  CAPTURED
  CAPTURE_FAIL
  FAILED
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum SizeType {
  LETTER
  NUMBER
  CUP
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PAYMENT_FAILED
  CANCELLED
  PREPARING
  SHIPPED
  DELIVERED
  REFUND_PENDING
  REFUNDED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  INITIATED
  CALLBACK_RECEIVED
  SUCCEEDED
  FAILED
  PENDING
  PAID
  REFUNDED
}

enum CampaignStatus {
  draft
  ready
  scheduled
  sending
  sent
  cancelled
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  variantId String?
  quantity  Int
  type      StockMovementType
  reason    String?
  userId    String?
  createdAt DateTime          @default(now())

  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  user    User?           @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([createdAt])
}

model ReturnRequest {
  id           String              @id @default(cuid())
  orderId      String
  userId       String
  status       ReturnStatus        @default(PENDING)
  reason       String
  description  String?
  images       String[]
  adminNote    String?
  refundAmount Float?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  items        ReturnRequestItem[]

  order Order @relation(fields: [orderId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}

model ReturnRequestItem {
  id              String  @id @default(cuid())
  returnRequestId String
  orderItemId     String
  quantity        Int
  reason          String?

  returnRequest ReturnRequest @relation(fields: [returnRequestId], references: [id])
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])
}

model Supplier {
  id          String            @id @default(cuid())
  name        String
  contactName String?
  email       String?
  phone       String?
  address     String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  products    ProductSupplier[]
  orders      SupplyOrder[]
}

model ProductSupplier {
  id          String  @id @default(cuid())
  productId   String
  supplierId  String
  costPrice   Float?
  supplierSku String?

  product  Product  @relation(fields: [productId], references: [id])
  supplier Supplier @relation(fields: [supplierId], references: [id])

  @@unique([productId, supplierId])
}

model SupplyOrder {
  id           String            @id @default(cuid())
  supplierId   String
  status       SupplyOrderStatus @default(DRAFT)
  totalAmount  Float?
  expectedDate DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  items        SupplyOrderItem[]

  supplier Supplier @relation(fields: [supplierId], references: [id])
}

model SupplyOrderItem {
  id            String @id @default(cuid())
  supplyOrderId String
  productId     String
  quantity      Int
  unitCost      Float

  supplyOrder SupplyOrder @relation(fields: [supplyOrderId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
}

enum StockMovementType {
  PURCHASE
  SALE
  RETURN
  ADJUSTMENT
  DAMAGED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

enum SupplyOrderStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

model StockAlert {
  id        String   @id @default(cuid())
  productId String
  variantId String?
  threshold Int      @default(5)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId])
  @@index([productId])
  @@index([variantId])
}

model PaymentAttempt {
  id       String        @id @default(cuid())
  orderId  String        @unique
  provider String        @default("IYZICO")
  status   PaymentStatus @default(INITIATED)

  conversationId String?
  token          String? @unique
  paymentId      String?
  rawResult      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])
}

model StockReservation {
  id         String    @id @default(cuid())
  orderId    String
  variantId  String
  quantity   Int
  expiresAt  DateTime
  releasedAt DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@index([expiresAt])
  @@index([orderId])
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BlogPost {
  id              String  @id @default(cuid())
  title           String
  slug            String  @unique
  content         String
  excerpt         String?
  coverImage      String?
  metaTitle       String?
  metaDescription String?
  isPublished     Boolean @default(false)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tags     String[]
  category String?

  @@index([slug])
  @@index([isPublished])
  @@index([category])
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String // order, payment, return, shipping, product, account
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
}

model SupportTicket {
  id        String       @id @default(cuid())
  userId    String
  subject   String
  category  String // order, payment, return, product, other
  status    TicketStatus @default(open)
  priority  String       @default("normal")
  orderId   String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user     User            @relation(fields: [userId], references: [id])
  messages TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  userId    String?
  isAdmin   Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

enum TicketStatus {
  open
  pending
  resolved
  closed
}

model AdminNotification {
  id        String   @id @default(cuid())
  type      String   // ORDER, STOCK, RETURN, SYSTEM, SUPPORT
  title     String
  message   String
  link      String?  // Optional link to relevant page (e.g. /admin-orders/123)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model PriceAlert {
  id           String   @id @default(cuid())
  userId       String?
  email        String
  productId    String
  targetPrice  Float?
  currentPrice Float
  isNotified   Boolean  @default(false)
  createdAt    DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isNotified])
}

model StockNotification {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  productId  String
  variantId  String?
  isNotified Boolean  @default(false)
  createdAt  DateTime @default(now())

  product Product @relation("StockNotifications", fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isNotified])
}

model LoyaltyPoint {
  id        String    @id @default(cuid())
  userId    String
  points    Int
  type      String // earned, spent, expired
  reason    String // purchase, review, referral, birthday, signup
  orderId   String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model ProductBundle {
  id           String   @id @default(cuid())
  name         String
  description  String?
  slug         String   @unique
  discountRate Int
  image        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items BundleItem[]

  @@index([isActive])
  @@index([slug])
}

model BundleItem {
  id        String @id @default(cuid())
  bundleId  String
  productId String
  quantity  Int    @default(1)

  bundle  ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id])

  @@index([bundleId])
  @@index([productId])
}


model WashingInstruction {
  id        String    @id @default(cuid())
  title     String
  content   String    @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
}

model DeliveryInfo {
  id        String    @id @default(cuid())
  title     String
  content   String    @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
}

model SizeNote {
  id        String    @id @default(cuid())
  title     String
  content   String    @db.Text
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
}

model SizeGuide {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String?
  content   Json?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
}

model ModelInfo {
  id        String    @id @default(cuid())
  title     String
  height    String
  size      String
  gender    Gender?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive])
  @@index([gender])
}


model AnalyticsEvent {
  id        String   @id @default(cuid())
  sessionId String
  userId    String?
  eventType String // VIEW_PRODUCT, ADD_TO_CART, BEGIN_CHECKOUT, PURCHASE, etc.
  eventData Json? // Flexible data storage for event metadata
  page      String?
  referrer  String?
  userAgent String?
  ipAddress String?
  timestamp DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@index([eventType])
  @@index([timestamp])
  @@index([page])
}

model AnalyticsSession {
  id          String    @id @default(cuid())
  sessionId   String    @unique
  userId      String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  device      String?
  browser     String?
  country     String?
  referrer    String?
  landingPage String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([startedAt])
  @@index([sessionId])
}

model Funnel {
  id          String       @id @default(cuid())
  name        String
  description String?
  steps       FunnelStep[]
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([isActive])
}

model FunnelStep {
  id        String @id @default(cuid())
  funnelId  String
  stepOrder Int
  eventType String // Event type to track (e.g., VIEW_PRODUCT, ADD_TO_CART)
  name      String

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, stepOrder])
  @@index([funnelId])
}

model HeatmapClick {
  id        String   @id @default(cuid())
  page      String // Page URL or identifier
  elementId String? // DOM element ID if available
  xPercent  Float // X position as percentage of viewport
  yPercent  Float // Y position as percentage of viewport
  timestamp DateTime @default(now())
  userId    String?
  sessionId String
  device    String? // mobile, tablet, desktop

  @@index([page])
  @@index([timestamp])
  @@index([sessionId])
}


model Showcase {
  id        String   @id @default(cuid())
  productId String   @unique 
  order     Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model TabbedCarouselProduct {
  id        String   @id @default(cuid())
  tab       String   // "new-arrivals", "best-sellers", "recommended" vb.
  productId String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tab, productId])
}

model Collection {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  slug        String   @unique
  image1      String?
  image2      String?
  image3      String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    CollectionProduct[]
}

model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  productId    String
  order        Int        @default(0)
  createdAt    DateTime   @default(now())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([collectionId])
  @@index([productId])
}

model NewArrival {
  id        String   @id @default(cuid())
  productId String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}


model LookConfiguration {
  id                String     @id @default(cuid())
  mainProductId     String     @unique
  title             String?    @default("Takımı Tamamla")
  priority          Int        @default(0) // 0: Normal, 1: Yüksek
  isVisible         Boolean    @default(true)
  showAllAddButton  Boolean    @default(true)
  showTotalPrice    Boolean    @default(true)
  showDiscountBadge Boolean    @default(false)
  status            String     @default("DRAFT") // DRAFT, PUBLISHED
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  
  mainProduct       Product    @relation("MainProductLook", fields: [mainProductId], references: [id], onDelete: Cascade)
  items             LookItem[]
}

model LookItem {
  id                  String            @id @default(cuid())
  lookConfigurationId String
  productId           String
  order               Int               @default(0)
  createdAt           DateTime          @default(now())
  
  lookConfiguration   LookConfiguration @relation(fields: [lookConfigurationId], references: [id], onDelete: Cascade)
  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([lookConfigurationId, productId])
}

